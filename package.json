{
  "name": "ignite",
  "version": "1.0.0",
  "description": "Supabase database for Ignite: gig-worker identity + civic service requests",
  "scripts": {
    "db:push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:diff": "supabase db diff --db-url \"$SUPABASE_DB_URL\"",
    "db:dry": "supabase db push --db-url \"$SUPABASE_DB_URL\" --dry-run",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > src/lib/database.types.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  },
  "private": true
}
