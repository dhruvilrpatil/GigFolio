# GigFolio Backend — Environment Variables
# Copy to .env.local for local development

# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=https://gigfolio.io

# PostgreSQL (Developer 1 owns schema/migrations)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gigfolio
DB_PASSWORD=changeme
DB_NAME=gigfolio

# Redis (Developer 1 owns Redis infra)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudflare R2 (for QR code storage in production)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=gigfolio-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# JWT (Developer 1 owns JWT signing — configure here for local dev)
JWT_SECRET=local-dev-secret-replace-in-production
JWT_EXPIRY=1h
